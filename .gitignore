src/paint_overlay.json
# build_zones.py: cached transit/hop plans
src/hop_cache.json
# build_zones.py writes its run report here (a snapshot is kept in results/)
src/build_report.json
# build_zones.py --dry
src/build_report_dry.json
# make_cell_layout.py writes STLs + layout_plan.png here (a snapshot is kept in results/)
src/cell_layout/

